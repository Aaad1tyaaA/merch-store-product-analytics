table definition_sensitivity
	lineageTag: 47b09d05-cf7c-8ec8-add7-9acaeb7eecb3

	measure 'Sensitivity conversion' = AVERAGE(definition_sensitivity[session_conversion])
		formatString: 0.00%
		lineageTag: ed3fab92-576b-2a0b-c580-f43176e173ad

	measure 'Sensitivity view rate' = AVERAGE(definition_sensitivity[product_view_rate])
		formatString: 0.0%
		lineageTag: f2f13ae6-3f4b-0e57-edf6-1f8eeda8f6a2

	measure 'Sensitivity orders' = SUM(definition_sensitivity[orders])
		formatString: #,0
		lineageTag: a277f5b7-4736-ef2b-1dce-a2c94396ba07

	column definition
		dataType: string
		lineageTag: f9376172-4511-c075-0935-a0f96e0ad068
