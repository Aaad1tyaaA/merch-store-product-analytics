	partition definition_sensitivity = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\definition_sensitivity.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"definition", type text}, {"sessions", type number}, {"orders", type number}, {"revenue_usd", type number}, {"session_conversion", type number}, {"product_view_rate", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
